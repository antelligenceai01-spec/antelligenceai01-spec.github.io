<script>
// الوضع الليلي/النهاري تلقائي
function applyTheme(hour){
  const body=document.body, header=document.getElementById('main-header');
  if(hour>=18||hour<6){ body.classList.add('night'); body.classList.remove('day'); header.classList.add('night'); header.classList.remove('day');}
  else{ body.classList.add('day'); body.classList.remove('night'); header.classList.add('day'); header.classList.remove('night');}
}
applyTheme(new Date().getHours());

// تبديل الوضع يدوي
function toggleTheme(){
  const body=document.body, header=document.getElementById('main-header');
  body.classList.toggle('night'); body.classList.toggle('day');
  header.classList.toggle('night'); header.classList.toggle('day');
}

// تبديل اللغة
function toggleLang(){
  const ar=document.getElementById('arabic'), en=document.getElementById('english'), btn=document.querySelector('.toggle-lang');
  if(ar.style.display==='none'){ 
    ar.style.display='block'; 
    en.style.display='none'; 
    btn.innerHTML = '<span>اللغة</span> 🌐 English';
  }
  else{ 
    ar.style.display='none'; 
    en.style.display='block'; 
    btn.innerHTML = '<span>Language</span> 🌐 العربية';
  }
}

// حركة العناوين عند التمرير
function animateTitles(){
  const titles=document.querySelectorAll('h2.animate');
  const windowBottom=window.innerHeight/1.2;
  titles.forEach(t=>{ 
    const top=t.getBoundingClientRect().top; 
    if(top<windowBottom) t.classList.add('visible');
  });
}
window.addEventListener('scroll',animateTitles);
animateTitles();

// زر العودة للأعلى
const backToTopButton = document.getElementById('backToTop');
window.addEventListener('scroll', () => {
  if (window.pageYOffset > 300) {
    backToTopButton.classList.add('visible');
  } else {
    backToTopButton.classList.remove('visible');
  }
});

// إصلاح روابط التنقل
document.querySelectorAll('a[href^="#"]').forEach(anchor => {
  anchor.addEventListener('click', function (e) {
    e.preventDefault();
    const targetId = this.getAttribute('href');
    if(targetId === '#') return;
    
    const target = document.querySelector(targetId);
    if (target) {
      const headerOffset = 100;
      const elementPosition = target.getBoundingClientRect().top;
      const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

      window.scrollTo({
        top: offsetPosition,
        behavior: 'smooth'
      });
    }
  });
});

